{
  "name": "distributed-perft",
  "version": "aug-16-2026",
  "owner": "Andrey Tsigler",
  "repo": "https://https://github.com/altsigler/distributed-perft/",
  "language": "C",
  "modes": {
    "single-no-cache": {
      "launch": "bin/distributed-perft/bin/scperft",
      "setup":  ["setoption name CacheEnable value 0"],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit": "quit"
    },
    "single-with-cache": {
      "launch": "bin/distributed-perft/bin/scperft",
      "setup":  ["setoption name CacheEnable value 1"],
      "case":   "position fen {fen}\ngo perft {depth}",
      "end_re": "^Nodes searched: \\d+$",
      "quit": "quit"
    }
  }
}
